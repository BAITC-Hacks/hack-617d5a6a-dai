{
  "openapi": "3.1.0",
  "info": {
    "title": "DAI — Граф денег API",
    "description": "Роли, кластеры и приоритеты проверки по графу переводов. gid всегда строкой.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Get Health",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/meta": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Get Meta",
        "description": "Сводка по выгрузке, источник ролей и словарь ролей для легенды.",
        "operationId": "get_meta",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/reload": {
      "post": {
        "tags": [
          "meta"
        ],
        "summary": "Reload Data",
        "description": "Перечитать outputs/ после прогона пайплайна, без перезапуска сервера.",
        "operationId": "reload_data",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReloadResponse"
                }
              }
            }
          }
        }
      }
    },
    "/graph": {
      "get": {
        "tags": [
          "graph"
        ],
        "summary": "Get Graph",
        "description": "Весь граф или его срез. Рёбра — только между возвращёнными узлами.",
        "operationId": "get_graph",
        "parameters": [
          {
            "name": "cluster_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Только узлы этого кластера",
              "title": "Cluster Id"
            },
            "description": "Только узлы этого кластера"
          },
          {
            "name": "role",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "consolidator",
                    "transit",
                    "distributor",
                    "terminal",
                    "coordinator",
                    "peripheral"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Только узлы этой роли",
              "title": "Role"
            },
            "description": "Только узлы этой роли"
          },
          {
            "name": "min_priority",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 1,
              "minimum": 0,
              "description": "Порог priority_score",
              "default": 0.0,
              "title": "Min Priority"
            },
            "description": "Порог priority_score"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5000,
              "minimum": 1,
              "description": "Максимум узлов, по убыванию priority_score",
              "default": 2500,
              "title": "Limit"
            },
            "description": "Максимум узлов, по убыванию priority_score"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "tags": [
          "graph"
        ],
        "summary": "Search Nodes",
        "description": "Поиск по началу gid; точное совпадение идёт первым.",
        "operationId": "search_nodes",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Начало строки gid",
              "title": "Q"
            },
            "description": "Начало строки gid"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/nodes/{gid}": {
      "get": {
        "tags": [
          "nodes"
        ],
        "summary": "Get Node",
        "description": "Карточка узла: роль с основанием, входящие и исходящие рёбра, отдельные переводы.",
        "operationId": "get_node",
        "parameters": [
          {
            "name": "gid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Gid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeCard"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/nodes/{gid}/subgraph": {
      "get": {
        "tags": [
          "nodes"
        ],
        "summary": "Get Node Subgraph",
        "description": "Окрестность узла для экрана: узлы в radius шагов (без учёта направления), рёбра — исходные направленные.",
        "operationId": "get_node_subgraph",
        "parameters": [
          {
            "name": "gid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Gid"
            }
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 3,
              "minimum": 1,
              "description": "Сколько шагов от узла в любую сторону",
              "default": 1,
              "title": "Radius"
            },
            "description": "Сколько шагов от узла в любую сторону"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GraphResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/top": {
      "get": {
        "tags": [
          "priority"
        ],
        "summary": "Get Top Nodes",
        "description": "Ранжированный список приоритетов (top_nodes.csv).",
        "operationId": "get_top_nodes",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 2248,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/clusters": {
      "get": {
        "tags": [
          "clusters"
        ],
        "summary": "List Clusters",
        "operationId": "list_clusters",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClustersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/clusters/{cluster_id}": {
      "get": {
        "tags": [
          "clusters"
        ],
        "summary": "Get Cluster",
        "description": "Паспорт кластера и его подграф.",
        "operationId": "get_cluster",
        "parameters": [
          {
            "name": "cluster_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Cluster Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClusterDetail": {
        "properties": {
          "cluster": {
            "$ref": "#/components/schemas/ClusterOut"
          },
          "graph": {
            "$ref": "#/components/schemas/GraphResponse"
          }
        },
        "type": "object",
        "required": [
          "cluster",
          "graph"
        ],
        "title": "ClusterDetail"
      },
      "ClusterOut": {
        "properties": {
          "cluster_id": {
            "type": "integer",
            "title": "Cluster Id"
          },
          "n_nodes": {
            "type": "integer",
            "title": "N Nodes"
          },
          "n_seed": {
            "type": "integer",
            "title": "N Seed"
          },
          "sum_kzt_internal": {
            "type": "number",
            "title": "Sum Kzt Internal",
            "description": "Сумма рёбер, у которых оба конца внутри кластера"
          },
          "top_gids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Top Gids"
          },
          "hypothesis": {
            "type": "string",
            "title": "Hypothesis",
            "description": "Гипотеза о назначении кластера, для проверки"
          }
        },
        "type": "object",
        "required": [
          "cluster_id",
          "n_nodes",
          "n_seed",
          "sum_kzt_internal",
          "top_gids",
          "hypothesis"
        ],
        "title": "ClusterOut"
      },
      "ClustersResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ClusterOut"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ClustersResponse"
      },
      "EdgeOut": {
        "properties": {
          "src": {
            "type": "string",
            "title": "Src"
          },
          "dst": {
            "type": "string",
            "title": "Dst"
          },
          "sum_kzt": {
            "type": "number",
            "title": "Sum Kzt"
          },
          "n_tx": {
            "type": "integer",
            "title": "N Tx"
          },
          "depth": {
            "type": "integer",
            "title": "Depth",
            "description": "Колено обхода, на котором найдено ребро (1–4)"
          }
        },
        "type": "object",
        "required": [
          "src",
          "dst",
          "sum_kzt",
          "n_tx",
          "depth"
        ],
        "title": "EdgeOut",
        "description": "Направленное ребро: агрегат переводов src → dst за период."
      },
      "GraphMeta": {
        "properties": {
          "mock": {
            "type": "boolean",
            "title": "Mock",
            "description": "True: роли и скоры — заглушка по простым порогам, не результат пайплайна"
          },
          "n_nodes": {
            "type": "integer",
            "title": "N Nodes"
          },
          "n_edges": {
            "type": "integer",
            "title": "N Edges"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated",
            "description": "True, если список узлов обрезан параметром limit"
          }
        },
        "type": "object",
        "required": [
          "mock",
          "n_nodes",
          "n_edges",
          "truncated"
        ],
        "title": "GraphMeta"
      },
      "GraphResponse": {
        "properties": {
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/NodeOut"
            },
            "type": "array",
            "title": "Nodes"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/EdgeOut"
            },
            "type": "array",
            "title": "Edges",
            "description": "Только рёбра, у которых оба конца есть в nodes"
          },
          "meta": {
            "$ref": "#/components/schemas/GraphMeta"
          }
        },
        "type": "object",
        "required": [
          "nodes",
          "edges",
          "meta"
        ],
        "title": "GraphResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "mock": {
            "type": "boolean",
            "title": "Mock"
          }
        },
        "type": "object",
        "required": [
          "status",
          "mock"
        ],
        "title": "HealthResponse"
      },
      "MetaResponse": {
        "properties": {
          "mock": {
            "type": "boolean",
            "title": "Mock"
          },
          "source": {
            "type": "string",
            "enum": [
              "outputs",
              "mock"
            ],
            "title": "Source",
            "description": "outputs: CSV пайплайна; mock: заглушка по порогам"
          },
          "n_nodes": {
            "type": "integer",
            "title": "N Nodes"
          },
          "n_edges": {
            "type": "integer",
            "title": "N Edges"
          },
          "n_transactions": {
            "type": "integer",
            "title": "N Transactions"
          },
          "n_seed": {
            "type": "integer",
            "title": "N Seed"
          },
          "n_clusters": {
            "type": "integer",
            "title": "N Clusters"
          },
          "period_start": {
            "type": "string",
            "format": "date",
            "title": "Period Start"
          },
          "period_end": {
            "type": "string",
            "format": "date",
            "title": "Period End"
          },
          "total_kzt": {
            "type": "number",
            "title": "Total Kzt"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/RoleInfo"
            },
            "type": "array",
            "title": "Roles"
          },
          "method": {
            "type": "string",
            "title": "Method",
            "description": "Метод пайплайна из run_meta.json (v1, v0) или mock",
            "default": "mock"
          },
          "threshold_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold Score",
            "description": "Порог приоритета на шкале priority_score 0–1"
          },
          "threshold_raw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Threshold Raw",
            "description": "Порог приоритета на сырой шкале priority_raw"
          },
          "elapsed_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Elapsed S",
            "description": "Время прогона пайплайна, с"
          },
          "n_in_queue": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "N In Queue",
            "description": "Сколько узлов в очереди проверки (run_meta.json)"
          },
          "queue_rule": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Queue Rule",
            "description": "Правило очереди проверки текстом (run_meta.json)"
          }
        },
        "type": "object",
        "required": [
          "mock",
          "source",
          "n_nodes",
          "n_edges",
          "n_transactions",
          "n_seed",
          "n_clusters",
          "period_start",
          "period_end",
          "total_kzt",
          "roles"
        ],
        "title": "MetaResponse"
      },
      "NodeCard": {
        "properties": {
          "node": {
            "$ref": "#/components/schemas/NodeOut"
          },
          "in_edges": {
            "items": {
              "$ref": "#/components/schemas/EdgeOut"
            },
            "type": "array",
            "title": "In Edges"
          },
          "out_edges": {
            "items": {
              "$ref": "#/components/schemas/EdgeOut"
            },
            "type": "array",
            "title": "Out Edges"
          },
          "transfers": {
            "items": {
              "$ref": "#/components/schemas/TransferOut"
            },
            "type": "array",
            "title": "Transfers",
            "description": "Все переводы с участием узла, по дате"
          },
          "pairs": {
            "items": {
              "$ref": "#/components/schemas/TransferPair"
            },
            "type": "array",
            "title": "Pairs",
            "description": "Пары вход→выход узла, по дате входа"
          }
        },
        "type": "object",
        "required": [
          "node",
          "in_edges",
          "out_edges",
          "transfers"
        ],
        "title": "NodeCard",
        "description": "Карточка узла: сам узел, его рёбра, отдельные переводы и пары вход→выход."
      },
      "NodeOut": {
        "properties": {
          "gid": {
            "type": "string",
            "title": "Gid",
            "description": "Идентификатор клиента строкой (int64 в данных)"
          },
          "role": {
            "type": "string",
            "enum": [
              "consolidator",
              "transit",
              "distributor",
              "terminal",
              "coordinator",
              "peripheral"
            ],
            "title": "Role",
            "description": "Основная роль из словаря ТЗ"
          },
          "role_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Role Score",
            "description": "Сила поддержки правила роли, 0–1; не вероятность"
          },
          "cluster_id": {
            "type": "integer",
            "title": "Cluster Id",
            "description": "Номер кластера из clusters.csv"
          },
          "priority_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Priority Score",
            "description": "Приоритет проверки для аналитика, 0–1"
          },
          "evidence": {
            "type": "string",
            "maxLength": 200,
            "title": "Evidence",
            "description": "Почему такая роль: числа из расчёта, до 200 символов"
          },
          "depth": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Depth",
            "description": "Колено обхода, 0 = seed"
          },
          "is_seed": {
            "type": "boolean",
            "title": "Is Seed"
          },
          "in_deg": {
            "type": "integer",
            "title": "In Deg",
            "description": "От скольких разных клиентов получал"
          },
          "out_deg": {
            "type": "integer",
            "title": "Out Deg",
            "description": "Скольким разным клиентам отправлял"
          },
          "in_kzt": {
            "type": "number",
            "title": "In Kzt",
            "description": "Получено внутри графа, KZT"
          },
          "out_kzt": {
            "type": "number",
            "title": "Out Kzt",
            "description": "Отправлено внутри графа, KZT"
          },
          "in_tx": {
            "type": "integer",
            "title": "In Tx"
          },
          "out_tx": {
            "type": "integer",
            "title": "Out Tx"
          },
          "truncated_by_depth": {
            "type": "boolean",
            "title": "Truncated By Depth",
            "description": "Узел на 4-м колене без исходящих: граница выгрузки, не сток"
          },
          "priority_raw": {
            "type": "number",
            "title": "Priority Raw",
            "description": "Сырой скор до нормировки: сумма −ln(доли узлов не ниже) + вес быстрого транзита",
            "default": 0
          },
          "score_terms": {
            "type": "string",
            "title": "Score Terms",
            "description": "Два наибольших вклада в скор, например «in_deg=24 (P99, +7.7)»",
            "default": ""
          },
          "role_checks": {
            "type": "string",
            "title": "Role Checks",
            "description": "Условия назначенной роли с фактическими значениями, до 200 символов",
            "default": ""
          },
          "fast_transit_pairs": {
            "type": "integer",
            "title": "Fast Transit Pairs",
