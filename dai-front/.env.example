# Env template. Local dev:  cp .env.example .env.development
# Deploy: set the same vars in the hosting settings (no .env files are committed).

# Backend base URL. Dev: /api (Vite proxy -> API_PROXY_TARGET). Prod: full URL, e.g. https://api.example.com
VITE_API_URL=/api
# Dev only: "true" enables MSW mocks (never shipped to production)
VITE_MOCKS=true

# Dev proxy target is a shell var, not VITE_:  API_PROXY_TARGET=http://192.168.1.50:8000 npm run dev
